FROM python:3.13.15-slim-bookworm

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --disable-pip-version-check "uv==0.13.0" \
    && groupadd --system --gid 10001 research-draw \
    && useradd --system --uid 10001 --gid 10001 --create-home --home-dir /home/research-draw --shell /usr/sbin/nologin research-draw \
    && mkdir -p /workspace /tmp/matplotlib \
    && chown -R 10001:10001 /workspace /tmp/matplotlib

COPY pyproject.toml uv.lock README.md VERSION .python-version ./
COPY src ./src
COPY data ./data

RUN UV_PROJECT_ENVIRONMENT=/opt/venv UV_COMPILE_BYTECODE=1 uv sync --locked --no-dev \
    --extra mcp \
    --extra stats \
    --extra ml \
    --extra maps \
    --extra raster

USER 10001:10001

EXPOSE 8000

ENTRYPOINT ["/opt/venv/bin/python", "-m", "src.mcp_server.server"]
