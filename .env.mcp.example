# Copy this file to .env on the deployment server and set the real hostname.
# This is a path to the secret file, not the secret value itself.
# This is the common parent of all Koying session workspaces served by this instance.
# Each workspace tool call must pass its current session's absolute workspace_path.
# The container can access paths only beneath this root; choose the narrowest common parent.
# On Linux keep UID/GID 10001 and make the workspaces writable by that identity.
# On macOS set these to the host account UID/GID that owns the workspaces.
RESEARCH_DRAW_MCP_IMAGE=ghcr.io/keyingshuzhi/keying-research-draw-mcp:0.1.4
RESEARCH_DRAW_MCP_TOKEN_FILE_HOST=/etc/research-draw/mcp-token
RESEARCH_DRAW_MCP_HOST_WORKSPACES_ROOT=/path/to/common/koying-workspaces
RESEARCH_DRAW_MCP_UID=10001
RESEARCH_DRAW_MCP_GID=10001
RESEARCH_DRAW_MCP_ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*
RESEARCH_DRAW_MCP_ALLOWED_ORIGINS=https://mcp.example.com
RESEARCH_DRAW_MCP_HOST_PORT=8000
RESEARCH_DRAW_MCP_MAX_IMPORT_MB=200
RESEARCH_DRAW_MCP_MAX_UPLOAD_MB=32
RESEARCH_DRAW_MCP_MAX_REQUEST_BODY_MB=48
RESEARCH_DRAW_MCP_LOG_LEVEL=info
